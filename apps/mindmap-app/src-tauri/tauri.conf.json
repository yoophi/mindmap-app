{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mindmap",
  "version": "0.1.0",
  "identifier": "com.yoophi.mindmap-app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1426",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Mindmap", "width": 1240, "height": 800, "minWidth": 760, "minHeight": 520 }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png"] }
}
